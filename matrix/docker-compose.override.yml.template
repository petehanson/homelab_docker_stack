# Rendered to docker-compose.override.yml by setup.sh from MATRIX_DATA_DIR
# (default /opt/matrix), so these paths always match where setup.sh generated
# the Synapse config.
services:
  synapse:
    volumes:
      - __MATRIX_DATA_DIR__/synapse:/data

  postgres:
    volumes:
      - __MATRIX_DATA_DIR__/postgres:/var/lib/postgresql/data
